# ==============================================================================
# HelpRoster Client - Production Environment Configuration Template
# ==============================================================================
# In production, when the frontend is served behind Nginx (as defined in our
# Dockerfile / nginx.conf), API requests to /api/v1 are reverse-proxied directly
# to the backend container, so VITE_API_BASE_URL can simply be "/api/v1".
# If your backend is hosted on a separate subdomain (e.g. api.helproster.org),
# set VITE_API_BASE_URL to "https://api.helproster.org/api/v1".
# ==============================================================================

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="HelpRoster"
