# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=helproster_db
DB_CONNECTION_LIMIT=10

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_secret_key_change_in_prod

# Transactional Email (Optional for Phase 0)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@helproster.org
