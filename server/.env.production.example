# ==============================================================================
# HelpRoster Server - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production or set these environment variables in your
# hosting container / platform (e.g. AWS ECS, Render, Railway, DigitalOcean, Heroku).
# IMPORTANT: NEVER commit actual secrets or production passwords to version control!
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=production
PORT=5000

# Client Application URL (Allowed CORS Origin)
# Must match your public HTTPS frontend domain exactly (no trailing slash)
CLIENT_URL=https://helproster.org

# Production MySQL Database Configuration
# Use a dedicated database user with principle of least privilege
DB_HOST=db.internal.helproster.org
DB_PORT=3306
DB_USER=helproster_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_24_CHARS
DB_NAME=helproster_production
DB_CONNECTION_LIMIT=25

# Authentication & Cryptographic Secrets
# Generate high-entropy keys using: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_CRYPTOGRAPHIC_SECRET_KEY
JWT_EXPIRES_IN=7d
COOKIE_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_COOKIE_SIGNING_SECRET

# Transactional Email Configuration (SMTP / Resend / SendGrid / Amazon SES)
# Used for welcome notifications, verification alerts, and password resets
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_PRODUCTION_SMTP_PASSWORD_OR_API_KEY
SMTP_FROM="HelpRoster Support <notifications@helproster.org>"

# Optional Logging & Diagnostics
LOG_LEVEL=info
